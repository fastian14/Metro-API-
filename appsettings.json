{
  "MetroApi": {
    "BaseUrl": "https://stagingapi.gomwd.com",
    "TokenUrl": "/order/token",
    "Username": "YOUR_USERNAME",
    "Password": "YOUR_PASSWORD",
    "ClientId": "YOUR_CUSTOMER_NO",
    "AccountNumber": "YOUR_ACCOUNT_NUMBER",
    "TimeoutSeconds": 30,
    "TokenEarlyRefreshSeconds": 300,
    "CreateOrderPath": "/order/CreateOrder",
    "GetOrderLabelsPath": "/order/GetOrderLabels",
    "GetOrderBOLPath": "/order/GetOrderBOL"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
